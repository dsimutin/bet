*.py[cod]
*.egg-info/
dist/
build/
.eggs/
.env
.env.*
!.env.example
*.pyc
.venv/

# Data (raw data не коммитим, только структуру)
data/raw/*
data/staging/*
data/core/*
data/models/*
data/reports/*
data/signals/*
data/injuries/*
!data/raw/.gitkeep
!data/staging/.gitkeep
!data/staging/*.csv
!data/staging/free_sources/
!data/staging/free_sources/.gitkeep
!data/staging/free_sources/*.csv
!data/staging/free_sources/*.json
!data/staging/free_sources/*.jsonl
!data/staging/free_sources/*.ndjson
!data/staging/free_sources/*.txt
!data/core/.gitkeep
!data/core/paper_signal_ledger.json
