!data/models/*.pkl
!data/models/*.meta.json
!data/models/calibration_*.pkl
!data/reports/.gitkeep
!data/signals/.gitkeep
!data/injuries/.gitkeep

# Jupyter
.ipynb_checkpoints/
notebooks/*.ipynb

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Local databases (generated at runtime, stored in Supabase in production)
data/*.sqlite
data/*.db

# Secrets
configs/secrets.yaml
configs/secrets.local.yaml
*.token
*.key

# Model pickles — generated by CI, not version-controlled in source
data/models/*.pkl
data/models/*.meta.json
data/models/calibration_*.pkl

# Ruflo / claude-flow runtime artifacts
.swarm/memory.db
.swarm/memory.db-shm
.swarm/memory.db-wal
.claude/memory.db
ruvector.db
