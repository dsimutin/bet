# ─────────────────────────────────────────────────────────────────────────────
# Шаблон переменных окружения — Sports Betting Analytics MVP
# Скопируйте файл в .env и заполните значения:
#   cp .env.example .env
# НИКОГДА не добавляйте .env в git (он уже внесён в .gitignore)
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────
# The Odds API (https://the-odds-api.com)
# Используется для получения котировок с международных рынков
# (только аналитика — справедливая линия)
# ─────────────────────────────────────────
THE_ODDS_API_KEY=your_key_here

# ─────────────────────────────────────────
# SportsDataIO (необязательно, требует подписки)
# Источник расписания матчей и данных о травмах
# ─────────────────────────────────────────
SPORTSDATA_IO_KEY=your_key_here

# ─────────────────────────────────────────
# Telegram Bot
# Для получения уведомлений о сигналах
# Создайте бота через @BotFather и добавьте его в чат/канал
# ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
# По умолчанию CLI готовит dry-run payload. Реальная отправка включается
# только явным флагом --send-telegram.
# В GitHub Actions scheduled delivery включается отдельно:
# Repository Variable SCHEDULED_SEND_TELEGRAM=true

# ─────────────────────────────────────────
# Режим торговли
# ВАЖНО: установите true для безопасного демо-режима
# false допускается только после тщательного тестирования
# ─────────────────────────────────────────
# Set to true for paper trading only (recommended)
PAPER_TRADING_ONLY=true

# ─────────────────────────────────────────
# Логирование и хранилище данных
# ─────────────────────────────────────────
# Log level
LOG_LEVEL=INFO

# Data directory
DATA_DIR=./data
