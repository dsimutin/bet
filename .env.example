# ─────────────────────────────────────────────────────────────────────────────
# Sports Betting Analytics MVP — Environment Variables Template
# Copy to .env and fill in your values:
#   cp .env.example .env
# NEVER commit .env to git (it is in .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────
# Paths (absolute on Render, relative locally)
# ─────────────────────────────────────────
DATA_DIR=./data
MODEL_DIR=./data/models
LEDGER_PATH=./data/core/paper_signal_ledger.json
STAGING_DIR=./data/staging
REPORTS_DIR=./data/reports

# ─────────────────────────────────────────
# Leagues to process (comma-separated internal codes)
# Supported: EPL, BUNDESLIGA, LALIGA, SERIEA, LIGUE1
# ─────────────────────────────────────────
LEAGUES=EPL,BUNDESLIGA,LALIGA,SERIEA
OPENFOOTBALL_SEASONS=2021-22,2022-23,2023-24,2024-25

# ─────────────────────────────────────────
# Database
# PostgreSQL on Render (injected automatically from render.yaml).
# Without this, a local SQLite file is used at data/core/metadata.db.
# ─────────────────────────────────────────
# DATABASE_URL=postgresql://user:password@host:5432/bet

# ─────────────────────────────────────────
# The Odds API (https://the-odds-api.com)
# Required for live upcoming-match odds.
# Without this, signal pipeline uses staged historical data only.
# ─────────────────────────────────────────
THE_ODDS_API_KEY=your_key_here

# ─────────────────────────────────────────
# Telegram Bot (notifications)
# Create a bot via @BotFather and add it to your channel/chat.
# Without these, all signal notifications print to stdout (dry-run mode).
# ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ─────────────────────────────────────────
# Telegram MTProto client (live channel collector)
# Optional — only needed for live odds/tips ingestion from Telegram channels.
# Generate session string locally: python scripts/gen_telegram_session.py
# ─────────────────────────────────────────
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_SESSION_STR=your_session_string_here
# Comma-separated channel usernames or IDs to monitor:
TELEGRAM_CHANNELS=@channel_one,@channel_two

# ─────────────────────────────────────────
# Trading mode (always keep true for safety)
# ─────────────────────────────────────────
PAPER_TRADING_ONLY=true

# ─────────────────────────────────────────
# Flashscore data provider — DISABLED BY POLICY
#
# Direct scraping of flashscorekz.com or any Flashscore site violates
# their Terms of Service and robots.txt.  This flag exists so the setting
# is explicitly documented; the FlashscoreProvider always raises an error.
#
# Legal alternatives:
#   - football-data.co.uk  (free historical CSV)
#   - The Odds API         (live + historical, commercial)
#   - OpenFootball         (open-source historical, GitHub)
#   - ManualCsvProvider    (import a CSV you exported manually)
# ─────────────────────────────────────────
FLASHSCORE_ENABLED=false
FLASHSCORE_PROVIDER_MODE=disabled
# FLASHSCORE_RATE_LIMIT_SECONDS=5   (reserved, not used while provider is disabled)

# ─────────────────────────────────────────
# Logging & runtime
# ─────────────────────────────────────────
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1
