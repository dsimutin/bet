# ─────────────────────────────────────────────────────────────────────────────
# Sports Betting Analytics MVP — Environment Variables Template
# Copy to .env and fill in your values:
#   cp .env.example .env
# NEVER commit .env to git (it is in .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────
# Paths (absolute on Render, relative locally)
# ─────────────────────────────────────────
DATA_DIR=./data
MODEL_DIR=./data/models
LEDGER_PATH=./data/core/paper_signal_ledger.json
STAGING_DIR=./data/staging
REPORTS_DIR=./data/reports

# ─────────────────────────────────────────
# Leagues to process (comma-separated internal codes)
# Supported: EPL, BUNDESLIGA, LALIGA, SERIEA, LIGUE1
# ─────────────────────────────────────────
LEAGUES=EPL,BUNDESLIGA,LALIGA,SERIEA
OPENFOOTBALL_SEASONS=2021-22,2022-23,2023-24,2024-25

# ─────────────────────────────────────────
# Database
# PostgreSQL on Render (injected automatically from render.yaml).
# Without this, a local SQLite file is used at data/core/metadata.db.
# ─────────────────────────────────────────
# DATABASE_URL=postgresql://user:password@host:5432/bet
APP_ENV=development
REQUIRE_DATABASE=false
ALLOW_LOCAL_LEDGER_FALLBACK=true
WRITE_LOCAL_LEDGER_MIRROR=true

# ─────────────────────────────────────────
# The Odds API (https://the-odds-api.com)
# Required for live upcoming-match odds.
# Without this, signal pipeline uses staged historical data only.
# ─────────────────────────────────────────
THE_ODDS_API_KEY=your_key_here
CACHE_STORAGE_TTL_SECONDS=28800
ODDS_CACHE_TTL_SECONDS=28800
PRIORITY_ODDS_MAX_AGE_SECONDS=900
WATCHLIST_ODDS_MAX_AGE_SECONDS=3600
EXOTIC_WATCHLIST_ODDS_MAX_AGE_SECONDS=14400
THE_ODDS_API_MIN_REMAINING_HARD_STOP=25
THE_ODDS_API_MIN_REMAINING_PRIORITY_REFRESH=50
QUOTA_STATE_BACKEND=database

# ─────────────────────────────────────────
# Telegram Bot (notifications)
# Create a bot via @BotFather and add it to your channel/chat.
# Without these, all signal notifications print to stdout (dry-run mode).
# ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_MANUAL_REFRESH_COOLDOWN_SECONDS=300
ADMIN_API_TOKEN=
ENABLE_DEBUG_ROUTES=false

# ─────────────────────────────────────────
# Telegram MTProto client (live channel collector)
# Optional — only needed for live odds/tips ingestion from Telegram channels.
# Generate session string locally: python scripts/gen_telegram_session.py
# ─────────────────────────────────────────
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_SESSION_STR=your_session_string_here
# Comma-separated channel usernames or IDs to monitor:
TELEGRAM_CHANNELS=@channel_one,@channel_two

# ─────────────────────────────────────────
# Active monitoring mode (APScheduler inside Web Service)
# Set ACTIVE_MODE=true on Render to enable 3-hour automated cycle:
#   :00 signal scan → :20 settlement → :40 training check → :50 active report
# ─────────────────────────────────────────
ACTIVE_MODE=false
ACTIVE_REPORT_INTERVAL_HOURS=3
SIGNAL_SCAN_INTERVAL_HOURS=3
SETTLEMENT_INTERVAL_HOURS=3
TRAINING_CHECK_INTERVAL_HOURS=3

# Smart training: only retrain if at least N new settled matches since last run.
# Set FORCE_TRAINING=true to retrain unconditionally (useful on first deploy).
FORCE_TRAINING=false
MIN_NEW_SETTLED_MATCHES_FOR_TRAINING=10

# Telegram report types:
#   TELEGRAM_STATUS_REPORTS_ENABLED — 3-hour active report (even if no signals)
#   TELEGRAM_SIGNAL_ALERTS_ENABLED  — individual signal alerts sent immediately
TELEGRAM_STATUS_REPORTS_ENABLED=true
TELEGRAM_SIGNAL_ALERTS_ENABLED=true

# Sports configuration:
#   Only football/soccer has a trained Dixon-Coles model.
#   Other sports: architecture prepared, signals not generated ("model unavailable").
SPORTS=football

# ─────────────────────────────────────────
# Trading mode (always keep true for safety)
# ─────────────────────────────────────────
PAPER_TRADING_ONLY=true
ENABLE_TENNIS_SPREADS=false
ENABLE_TENNIS_TOTALS=false

# ─────────────────────────────────────────
# Flashscore data provider — DISABLED BY POLICY
#
# Direct scraping of flashscorekz.com or any Flashscore site violates
# their Terms of Service and robots.txt.  This flag exists so the setting
# is explicitly documented; the FlashscoreProvider always raises an error.
#
# Legal alternatives:
#   - football-data.co.uk  (free historical CSV)
#   - The Odds API         (live + historical, commercial)
#   - OpenFootball         (open-source historical, GitHub)
#   - ManualCsvProvider    (import a CSV you exported manually)
# ─────────────────────────────────────────
FLASHSCORE_ENABLED=false
FLASHSCORE_PROVIDER_MODE=disabled
# FLASHSCORE_RATE_LIMIT_SECONDS=5   (reserved, not used while provider is disabled)

# ─────────────────────────────────────────
# Logging & runtime
# ─────────────────────────────────────────
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1
